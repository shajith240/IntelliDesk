# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=intellidesk
# Optional direct index host from the Pinecone console.
PINECONE_HOST=
PINECONE_EMBEDDING_DIMENSIONS=3072

# Encrypts connected mailbox passwords at rest (AES-256-GCM). Generate once with:
#   openssl rand -base64 32
# Use the SAME value in every environment that shares this database, or stored
# credentials become unreadable and the mailbox must be reconnected.
MAILBOX_ENCRYPTION_KEY=

# --- Scheduled jobs / webhooks (server-only) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically. Generate with: openssl rand -hex 32
CRON_SECRET=
# Callers of POST /api/emails/ingest must send "Authorization: Bearer $EMAIL_INGEST_SECRET"
EMAIL_INGEST_SECRET=
# Public self-serve workspace sign-up. Leave false in production: admins add
# their team from Settings, and new workspaces are provisioned deliberately.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
