# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=intellidesk
# Optional direct index host from the Pinecone console.
PINECONE_HOST=
PINECONE_EMBEDDING_DIMENSIONS=3072

# Optional local IMAP parser compatibility
IMAP_USER=

# --- Scheduled jobs / webhooks (server-only) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically. Generate with: openssl rand -hex 32
CRON_SECRET=
# Callers of POST /api/emails/ingest must send "Authorization: Bearer $EMAIL_INGEST_SECRET"
EMAIL_INGEST_SECRET=
# Shows the "Load sample tickets" action in empty states (development only)
NEXT_PUBLIC_DEMO_MODE=false
